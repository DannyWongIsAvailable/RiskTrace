{
  "rules": [
    {
      "id": "risktrace-browser-upload",
      "allowed": {
        "origins": [
          "https://risktrace.pages.dev",
          "http://localhost:5173",
          "http://localhost:8788",
          "http://127.0.0.1:8788"
        ],
        "methods": [
          "GET",
          "PUT",
          "HEAD"
        ],
        "headers": [
          "Content-Type",
          "x-amz-checksum-sha256"
        ]
      },
      "exposeHeaders": [
        "ETag"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}